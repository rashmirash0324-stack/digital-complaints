PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/digital
JWT_SECRET=replace_with_a_64_char_random_hex_secret

# Optional: Configure SMTP to deliver real Email OTPs (e.g. Gmail App Password)
# Without SMTP, OTPs work in Dev Mode (printed in console & returned for local testing)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=your-email@gmail.com
